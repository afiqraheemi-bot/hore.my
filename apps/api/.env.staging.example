# Template for the staging VPS's real `apps/api/.env.staging` — copy
# this file to `apps/api/.env.staging`, fill in every placeholder
# marked CHANGE-ME, and never commit the result (it's gitignored).
# See docs/operations/staging-deployment.md for the full one-time
# setup walkthrough.

APP_NAME=hore.my
APP_ENV=staging
# Generate on the VPS itself, inside the built api image, so the key
# never passes through a shell history or a commit:
#   docker compose -f docker-compose.staging.yml run --rm api php artisan key:generate --show
APP_KEY=CHANGE-ME
APP_DEBUG=false
# Port matches infrastructure/caddy/Caddyfile's second site block —
# see that file's own comment for why this is a port, not a
# subdomain, split.
APP_URL=https://CHANGE-ME-staging-domain:8443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hore_my
DB_USERNAME=postgres
# Must match docker-compose.staging.yml's own POSTGRES_PASSWORD env
# var (set on the VPS shell/.env, not here) — the two are read
# independently, so a mismatch here silently breaks every DB
# connection.
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ADR-0008: the Nuxt SPA's own origin — comma-separated, never '*'.
# Same domain as APP_URL above, port 443 (the web service's own
# Caddy-terminated port), not 8443.
CORS_ALLOWED_ORIGINS=https://CHANGE-ME-staging-domain
SANCTUM_STATEFUL_DOMAINS=CHANGE-ME-staging-domain

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# No real transactional email exists in this codebase yet — mailpit
# (docker-compose.staging.yml's own mailpit service) catches whatever
# staging sends, exactly like local dev. Point this at a real SMTP
# provider only once real outbound email is actually needed.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
